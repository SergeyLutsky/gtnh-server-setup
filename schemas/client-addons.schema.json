{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GTNH managed client add-ons",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "serverModFilePatterns", "clientMods", "resourcePacks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "serverModFilePatterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "patterns"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9.*+_-]+\\.jar$" }
          }
        }
      }
    },
    "clientMods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "gtnh", "artifact"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "gtnh": { "type": "string", "minLength": 1 },
          "artifact": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "resourcePacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "gtnh", "folder", "archiveRoot", "artifact", "requiredEntries"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "gtnh": { "type": "string", "minLength": 1 },
          "folder": { "type": "string", "pattern": "^[A-Za-z0-9._ -]+$" },
          "archiveRoot": { "type": "string", "pattern": "^[A-Za-z0-9._ -]+$" },
          "artifact": { "$ref": "#/$defs/artifact" },
          "requiredEntries": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9._ /-]+$" }
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "sha256", "sizeBytes"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._+ -]+$" },
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
