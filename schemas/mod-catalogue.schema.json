{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SergeyLutsky/gtnh-server-setup/schemas/mod-catalogue.schema.json",
  "title": "GTNH optional mod catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "retiredMods", "mods"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "retiredMods": {
      "type": "array",
      "items": { "$ref": "#/$defs/retiredMod" }
    },
    "mods": {
      "type": "array",
      "items": { "$ref": "#/$defs/mod" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "retiredMod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifacts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._+()-]+\\.jar$" },
          "uniqueItems": true
        }
      }
    },
    "mod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "repository", "clientRequired", "releases"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "format": "uri", "pattern": "^https://github.com/" },
        "clientRequired": { "type": "boolean" },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "releases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gtnh", "version", "asset", "url", "sha256", "sizeBytes"],
            "properties": {
              "gtnh": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "asset": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri", "pattern": "^https://github.com/" },
              "sizeBytes": { "type": "integer", "minimum": 1 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "artifactEntries": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "runtimeRequirements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "jar"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "jar": { "type": "string", "pattern": "^[A-Za-z0-9._+()-]+\\.jar$" },
                    "clientRequired": { "type": "boolean" },
                    "artifact": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["url", "sha256", "sizeBytes"],
                      "properties": {
                        "url": { "type": "string", "format": "uri", "pattern": "^https://github.com/" },
                        "sha256": { "$ref": "#/$defs/sha256" },
                        "sizeBytes": { "type": "integer", "minimum": 1 }
                      }
                    },
                    "entries": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 },
                      "uniqueItems": true
                    }
                  }
                }
              },
              "contentPacks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "name", "version", "repository", "archive", "archiveRoot", "target", "replacePaths", "requiredEntries"],
                  "properties": {
                    "id": { "$ref": "#/$defs/id" },
                    "name": { "type": "string", "minLength": 1 },
                    "version": { "type": "string", "minLength": 1 },
                    "repository": { "type": "string", "format": "uri", "pattern": "^https://github.com/" },
                    "archive": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["name", "url", "sha256", "sizeBytes"],
                      "properties": {
                        "name": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+\\.zip$" },
                        "url": { "type": "string", "format": "uri", "pattern": "^https://github.com/" },
                        "sha256": { "$ref": "#/$defs/sha256" },
                        "sizeBytes": { "type": "integer", "minimum": 1 }
                      }
                    },
                    "archiveRoot": { "type": "string", "pattern": "^[A-Za-z0-9._+ =/-]+$" },
                    "target": { "type": "string", "pattern": "^config/[A-Za-z0-9._+ =/-]+$" },
                    "replacePaths": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string", "pattern": "^[A-Za-z0-9._+ =/-]+$" },
                      "uniqueItems": true
                    },
                    "requiredEntries": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string", "pattern": "^[A-Za-z0-9._+ =/-]+$" },
                      "uniqueItems": true
                    }
                  }
                }
              },
              "postStartChecks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "command", "contains"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "command": { "type": "string", "pattern": "^[A-Za-z0-9._ -]+$" },
                    "contains": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string", "minLength": 1 },
                      "uniqueItems": true
                    }
                  }
                }
              },
              "postStartLogChecks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "logContains"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "command": { "type": "string", "pattern": "^[A-Za-z0-9._ -]+$" },
                    "logContains": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "updateResetPaths": {
                "type": "array",
                "items": { "type": "string", "pattern": "^config/[A-Za-z0-9._/-]+$" },
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
